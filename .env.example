# Server-side only. Never prefix with NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trueown
# HTTP Basic password for /admin and /api/admin (username ignored). Local development only:
# ignored in production (NODE_ENV=production), where admin requires Supabase Auth. Unset = admin disabled.
ADMIN_PASSWORD=change-me
# Supabase (hosted). Public values; protected by RLS. Unset = local Docker fallback
# (direct Postgres + HTTP Basic admin).
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Hosted: use the Supabase pooler/direct connection string from Project Settings > Database.
# Never commit real values or add the service-role key to client code.
# Cloudflare Turnstile. The site key is public; the secret key is server-only.
# Server-side verification is enforced whenever TURNSTILE_SECRET_KEY is set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# Optional shared rate limiting (Upstash Redis REST). Unset = per-instance in-memory limits.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
# Upstash also caches geocoded addresses for 30 days (hashed keys, no raw text).

# Address geocoding fallback (Nominatim). Include a contact in the User-Agent per OSM policy.
# GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
# GEOCODER_USER_AGENT=TrueOwn/0.1 (+https://github.com/lnakhul/trueown; you@example.com)
# GEOCODER_MAX_REQUESTS_PER_SECOND=1
# Optional Sentry error tracking. Unset = disabled. The NEXT_PUBLIC_ DSN is used by the browser.
# Events are scrubbed of query strings, cookies, headers, bodies and user data.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Optional trace sampling (0-1, default 0.1).
SENTRY_TRACES_SAMPLE_RATE=0.1
# Optional, build-time only: source map upload.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# CLI only (npm run admin:grant). Bypasses RLS: keep it on a trusted machine, never in the deployed app.
# SUPABASE_SERVICE_ROLE_KEY=
# Map tiles (optional). Unset = keyless OpenStreetMap tiles darkened with CSS. For production
# traffic use a provider account (CARTO now requires an API key; Stadia, MapTiler also work):
# NEXT_PUBLIC_MAP_TILE_URL=https://tiles.example.com/dark/{z}/{x}/{y}.png?api_key=YOUR_BROWSER_KEY
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors &copy; Your Provider
# NEXT_PUBLIC_MAP_TILE_SUBDOMAINS=abc
# NEXT_PUBLIC_MAP_TILE_MAX_ZOOM=20
# NEXT_PUBLIC_MAP_TILE_DARK=true    # the style is already dark: skip the CSS darkening
# Optional, for npm run db:import:storefronts and db:match:registry: a free Socrata app token
# (NYC Open Data / data.ny.gov) avoids anonymous rate limits. Either name works.
# NYC_OPEN_DATA_APP_TOKEN=
# SOCRATA_APP_TOKEN=
# Required for npm run db:watch:ownership: a contact email sent in the User-Agent
# (the SEC asks every automated client to name one). Never shown publicly.
# OWNERSHIP_WATCH_CONTACT=you@example.com

# Public website. Both are optional; these are the defaults.
# NEXT_PUBLIC_SITE_URL=https://gettrueown.com     # canonical links, sitemap, link previews
# NEXT_PUBLIC_CONTACT_EMAIL=hello@gettrueown.com  # shown on About, Privacy and Terms
