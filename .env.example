# Server-side only. Never prefix with NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trueown
# HTTP Basic password for /admin and /api/admin (username ignored). Unset = admin disabled.
ADMIN_PASSWORD=change-me
# Supabase (hosted). Public values; protected by RLS. Unset = local Docker fallback
# (direct Postgres + HTTP Basic admin).
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Hosted: use the Supabase pooler/direct connection string from Project Settings > Database.
# Never commit real values or add the service-role key to client code.
# Cloudflare Turnstile. The site key is public; the secret key is server-only.
# Server-side verification is enforced whenever TURNSTILE_SECRET_KEY is set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# Optional shared rate limiting (Upstash Redis REST). Unset = per-instance in-memory limits.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
